# Base image for building the Flutter web app
FROM debian:latest AS build-env

# Update package lists and install necessary system dependencies, including sudo
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
       sudo curl git vim wget unzip libgconf-2-4 gdb libstdc++6 libglu1-mesa fonts-droid-fallback \
       python3 python3-pip python3-venv xdg-utils xdotool xvfb gnupg2 net-tools \
       build-essential cmake \
       fonts-liberation libatk-bridge2.0-0 libatk1.0-0 libatspi2.0-0 libcairo2 libcups2 \
       libgbm1 libgtk-3-0 libnspr4 libnss3 libpango-1.0-0 libu2f-udev libxcomposite1 libxdamage1 libxrandr2 \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Download Flutter SDK from Flutter GitHub repo
RUN git clone https://github.com/flutter/flutter.git /usr/local/flutter

# Set Flutter environment path
ENV PATH="/usr/local/flutter/bin:/usr/local/flutter/bin/cache/dart-sdk/bin:${PATH}"

# Run Flutter doctor to verify installation
RUN flutter doctor

# Enable Flutter web support
RUN flutter channel master \
    && flutter upgrade \
    && flutter config --enable-web

# Set the working directory
WORKDIR /app/

# Copy application files to the container
COPY . /app/

# Run build: 1 - clean, 2 - pub get, 3 - build web
RUN flutter clean
RUN flutter pub get
RUN flutter build web

# Create and activate a virtual environment for Python
RUN python3 -m venv /venv \
    && /venv/bin/pip install --upgrade pip setuptools wheel \
    && /venv/bin/pip install flask watchdog opencv-python Pillow pytest-playwright \
    && /venv/bin/playwright install \
    && /venv/bin/playwright install-deps

# Set the virtual environment in the PATH
ENV PATH="/venv/bin:$PATH"

# Expose the ports for Nginx and Python application
EXPOSE 5000

# Run a custom script to start both Flask API and the Flutter web server
CMD ["python3", "main.py"]

# Use Nginx to serve the built Flutter web app
FROM nginx:1.25.2-alpine

# Copy the built web app to the Nginx default directory
COPY --from=build-env /app/build/web /usr/share/nginx/html

# Expose Nginx port
EXPOSE 80

# Start Nginx
CMD ["nginx", "-g", "daemon off;"]


