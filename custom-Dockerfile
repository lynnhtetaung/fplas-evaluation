# Base image
FROM python:3.9-slim AS build-env

# Update package lists and install necessary system dependencies
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
       curl git vim wget unzip libgconf-2-4 gdb libstdc++6 libglu1-mesa fonts-droid-fallback \
       python3 python3-pip xdg-utils xdotool xvfb gnupg2 net-tools \
       build-essential cmake \
       fonts-liberation libatk-bridge2.0-0 libatk1.0-0 libatspi2.0-0 libcairo2 libcups2 \
       libgbm1 libgtk-3-0 libnspr4 libnss3 libpango-1.0-0 libu2f-udev libxcomposite1 libxdamage1 libxrandr2 \
       lsof \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Download Flutter SDK from Flutter GitHub repo
RUN git clone https://github.com/flutter/flutter.git /usr/local/flutter

# Set Flutter environment path
ENV PATH="/usr/local/flutter/bin:/usr/local/flutter/bin/cache/dart-sdk/bin:${PATH}"

# Run Flutter doctor to verify installation
RUN flutter doctor

# Enable Flutter web support
RUN flutter channel master \
    && flutter upgrade \
    && flutter config --enable-web

# Set the working directory
WORKDIR /app/

# Copy application files and scripts to the container
COPY . /app/

# Upgrade pip, setuptools, and wheel to the latest versions
RUN pip3 install --upgrade pip setuptools wheel

# Install Python packages and Playwright
RUN pip3 install flask watchdog opencv-python Pillow pytest-playwright \
    && playwright install \
    && playwright install-deps

# Expose necessary ports
EXPOSE 5000 8080

# Set executable permissions for the build_and_serve.sh script
RUN chmod +x /app/start_services.sh

# Run a custom script to start both Flask API and the Flutter web server
ENTRYPOINT ["./start_services.sh"]


